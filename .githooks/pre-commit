#!/usr/bin/env bash
# Optimize staged PNGs/JPEGs before they're committed - pngquant for
# PNGs, jpegoptim for JPEGs (plus a resize cap, since a couple of past
# images were huge in *dimension*, not just badly compressed - see
# 3415dda0 for the manual pass this replaces going forward).
#
# GIFs are left alone: lossy gifsicle compression only saved 10-20% on
# the ones already in this repo and risked smearing the text they
# contain - not worth doing unconditionally on every future GIF.
#
# Missing pngquant/jpegoptim/imagemagick blocks the commit (only if a
# PNG/JPEG is actually staged) rather than silently letting an
# uncompressed image through - easy to miss a warning buried in commit
# output, much harder to miss a failed commit.
#
# One-time setup (per clone): git config core.hooksPath .githooks
set -euo pipefail

MAX_WIDTH=1600

have() { command -v "$1" >/dev/null 2>&1; }

while IFS= read -r -d '' f; do
  [ -f "$f" ] || continue
  case "$f" in
    *.png|*.PNG)
      if ! have pngquant; then
        echo "pre-commit: pngquant is required to commit PNGs (staged: $f)." >&2
        echo "Install it (e.g. apt install pngquant) and retry, or commit with --no-verify to skip." >&2
        exit 1
      fi
      # 98/99 mean pngquant deliberately skipped writing (the file's
      # already small enough, or already below the quality floor) -
      # that's success, not failure, so it shouldn't trip `set -e`.
      before=$(wc -c <"$f")
      set +e
      pngquant --quality=70-90 --skip-if-larger --force --ext .png "$f"
      rc=$?
      set -e
      if [ $rc -ne 0 ] && [ $rc -ne 98 ] && [ $rc -ne 99 ]; then
        echo "pre-commit: pngquant failed (exit $rc) on $f" >&2
        exit 1
      fi
      # pngquant itself is silent unless --verbose (which is too noisy to
      # use here) - print our own one-liner so a normal commit shows
      # *something* happened, rather than zero feedback either way.
      echo "pre-commit: $f: ${before} -> $(wc -c <"$f") bytes"
      git add "$f"
      ;;
    *.jpg|*.jpeg|*.JPG|*.JPEG)
      if ! have jpegoptim; then
        echo "pre-commit: jpegoptim is required to commit JPEGs (staged: $f)." >&2
        echo "Install it (e.g. apt install jpegoptim) and retry, or commit with --no-verify to skip." >&2
        exit 1
      fi
      if ! have convert; then
        echo "pre-commit: imagemagick (convert) is required to commit JPEGs (staged: $f)." >&2
        echo "Install it (e.g. apt install imagemagick) and retry, or commit with --no-verify to skip." >&2
        exit 1
      fi
      convert "$f" -resize "${MAX_WIDTH}x${MAX_WIDTH}>" -quality 82 "$f"
      # jpegoptim already prints its own before/after summary - let it
      # through instead of throwing it away, same reasoning as the
      # pngquant one-liner above.
      jpegoptim --max=85 --strip-all "$f"
      git add "$f"
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACM -z)

# Require a non-empty `description` in the front matter of any staged
# blog post - easy to forget since older posts don't have one, but we
# want every post from here on to have one (helps link previews / RSS
# readers show something better than the raw title).
missing_description=()
while IFS= read -r -d '' f; do
  [ -f "$f" ] || continue
  case "$f" in
    content/blog/*.md)
      front_matter=$(awk '/^---$/{n++; next} n==1' "$f")
      if ! grep -Eq '^description:[[:space:]]*"[^"]+"' <<<"$front_matter" \
        && ! grep -Eq "^description:[[:space:]]*'[^']+'" <<<"$front_matter" \
        && ! grep -Eq '^description:[[:space:]]+[^"'"'"'[:space:]].*$' <<<"$front_matter"; then
        missing_description+=("$f")
      fi
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACM -z)

if [ ${#missing_description[@]} -gt 0 ]; then
  echo "pre-commit: missing 'description' in front matter for:" >&2
  printf '  %s\n' "${missing_description[@]}" >&2
  echo "Add a description, or commit with --no-verify to skip." >&2
  exit 1
fi
